# Server Config
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# JWT Configuration
JWT_SECRET=super_secret_js_bootcamp_key_change_in_production
JWT_EXPIRES_IN=7d

# Turso Cloud Database Config
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your_turso_db_auth_token_here

# Brevo API Email Config
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@jsbootcamp.com
BREVO_SENDER_NAME="JS Bootcamp Team"

# Google Gemini AI Config
GEMINI_API_KEY=your_gemini_api_key_here
